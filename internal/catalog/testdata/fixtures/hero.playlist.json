{
  "id": "#0",
  "kind": "container",
  "template": "hero",
  "templateVariant": "playlist",
  "settings": {
    "maxWidth": "content",
    "padding": 0,
    "surface": {
      "padding": "section",
      "background": {
        "type": "tint"
      }
    }
  },
  "dataSource": {
    "type": "playlist",
    "id": ""
  },
  "collapseWhenEmpty": true,
  "children": [
    {
      "id": "#1",
      "kind": "row",
      "settings": {
        "responsive": true,
        "split": true,
        "gap": "section"
      },
      "children": [
        {
          "id": "#2",
          "kind": "media-slot",
          "settings": {
            "name": "cover",
            "preset": "medium-720",
            "aspectRatio": "16:9",
            "radius": "m",
            "outline": true
          }
        },
        {
          "id": "#3",
          "kind": "stack",
          "settings": {
            "gap": 2,
            "align": "start"
          },
          "children": [
            {
              "id": "#4",
              "kind": "field",
              "settings": {
                "name": "title",
                "role": "title",
                "size": "title",
                "weight": 700
              }
            },
            {
              "id": "#5",
              "kind": "row",
              "settings": {
                "gap": 2.5,
                "align": "center"
              },
              "children": [
                {
                  "id": "#6",
                  "kind": "field",
                  "settings": {
                    "name": "progressLabel",
                    "role": "meta",
                    "tone": "primary",
                    "ring": {
                      "valueFrom": "progressPercent",
                      "size": 16
                    },
                    "optional": true
                  }
                },
                {
                  "id": "#7",
                  "kind": "field",
                  "settings": {
                    "name": "scheduledDate",
                    "role": "meta",
                    "icon": "calendar",
                    "optional": true
                  }
                },
                {
                  "id": "#8",
                  "kind": "field",
                  "settings": {
                    "name": "status",
                    "role": "meta",
                    "tone": "primary",
                    "ring": {
                      "value": 100,
                      "size": 16
                    },
                    "optional": true
                  }
                },
                {
                  "id": "#9",
                  "kind": "field",
                  "settings": {
                    "name": "contentCountLabel",
                    "role": "meta",
                    "icon": "content",
                    "optional": true
                  }
                },
                {
                  "id": "#10",
                  "kind": "field",
                  "settings": {
                    "name": "duration",
                    "role": "meta",
                    "icon": "clock",
                    "optional": true
                  }
                }
              ]
            },
            {
              "id": "#11",
              "kind": "field",
              "settings": {
                "name": "description",
                "role": "body",
                "clamp": 5,
                "marginBottom": 4,
                "optional": true
              }
            },
            {
              "id": "#12",
              "kind": "divider",
              "settings": {
                "opacity": 10,
                "visibleFrom": "nextLessonTitle"
              }
            },
            {
              "id": "#13",
              "kind": "row",
              "settings": {
                "gap": 5,
                "align": "center",
                "fullWidth": true
              },
              "children": [
                {
                  "id": "#14",
                  "kind": "media-slot",
                  "settings": {
                    "name": "nextLessonCover",
                    "aspectRatio": "16:9",
                    "radius": "m",
                    "outline": true,
                    "width": 113,
                    "visibleFrom": "nextLessonTitle",
                    "visibility": {
                      "mobile": false
                    }
                  }
                },
                {
                  "id": "#15",
                  "kind": "field",
                  "settings": {
                    "name": "nextLessonTitle",
                    "size": "body",
                    "weight": 700,
                    "fade": true,
                    "optional": true
                  }
                },
                {
                  "id": "#16",
                  "kind": "button",
                  "settings": {
                    "compactMobile": true,
                    "icon": "play-filled",
                    "iconFrom": "ctaIcon",
                    "labelFrom": "ctaLabel",
                    "actionFromScope": "ctaAction",
                    "disabledFrom": "ctaDisabled"
                  },
                  "value": "Start watching"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
